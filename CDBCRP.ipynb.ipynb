def build_daily_curves(df):
# for each date, extract sorted (tenor, yield) pairs
# returns dict: {date: (tenors_array, yields_array)}
curves = {}
for fecha, grp in df.groupby(‘Fecha’):
g = grp.sort_values(‘Dias’)
tenors = g[‘Dias’].values.astype(float)
yields = g[‘Yield’].values.astype(float)
# remove duplicates (average if same tenor)
unique_tenors = np.unique(tenors)
if len(unique_tenors) < len(tenors):
avg_yields = np.array([yields[tenors == t].mean() for t in unique_tenors])
tenors, yields = unique_tenors, avg_yields
# need at least 2 points
if len(tenors) >= 2:
curves[fecha] = (tenors, yields)
return curves

def interpolate_to_grid(curves, grid):
# for each date, monotone convex interpolate to the fixed grid
# returns dataframe: index=dates, columns=grid tenors
dates = sorted(curves.keys())
data = {}
for d in dates:
tenors, yields = curves[d]
# only interpolate within the range of available tenors
min_t, max_t = tenors.min(), tenors.max()
interp = monotone_convex_interpolate(tenors, yields, grid)
# mask tenors outside the instrument range
mask = (grid >= min_t) & (grid <= max_t)
row = np.where(mask, interp, np.nan)
data[d] = row
return pd.DataFrame(data, index=grid).T.sort_index()

def run_pca(curve_matrix, n_pcs):
# curve_matrix: (n_obs x n_tenors), no nans
# returns eigenvalues, eigenvectors (loadings), mean
mu = curve_matrix.mean(axis=0)
X = curve_matrix - mu
cov = np.cov(X, rowvar=False)
eigenvalues, eigenvectors = np.linalg.eigh(cov)
# sort descending
idx = np.argsort(eigenvalues)[::-1]
eigenvalues = eigenvalues[idx]
eigenvectors = eigenvectors[:, idx]
return eigenvalues, eigenvectors[:, :n_pcs], mu

def impulse_response_matrix(loadings, shock_bps=10):
# loadings: (n_tenors x k)
# for each tenor i as shock source, compute min-norm propagation
n_tenors, k = loadings.shape
irm = np.zeros((n_tenors, n_tenors))
for i in range(n_tenors):
l_tau = loadings[i:i+1, :]  # (1 x k)
# min-norm: dz = L_tau^T (L_tau L_tau^T)^{-1} * shock
LLt = l_tau @ l_tau.T  # (1 x 1)
if LLt[0, 0] < 1e-12:
continue
dz = l_tau.T @ np.linalg.inv(LLt) * shock_bps  # (k x 1)
dy = loadings @ dz  # (n_tenors x 1)
irm[i, :] = dy.flatten()
return irm

# %% Cell 3 - Load, Process, Diagnostics

# load data

df = pd.read_excel(FILE_PATH)
df.columns = [‘Fecha’, ‘ISIN’, ‘Yield’, ‘Dias’]
df[‘Fecha’] = pd.to_datetime(df[‘Fecha’], dayfirst=True)
df = df.dropna(subset=[‘Yield’, ‘Dias’])
df = df[df[‘Dias’] > 0]

# build raw curves and interpolate to 10d grid

raw_curves = build_daily_curves(df)
grid_df = interpolate_to_grid(raw_curves, TENORS_GRID)
print(f’Total dates: {len(grid_df)}’)
print(f’Grid tenors: {list(TENORS_GRID)}’)
print(f’NaN coverage by tenor:\n{grid_df.isna().mean().round(3)}’)

# use the last 200d window for diagnostic

# drop columns with >10% nans in the window

window = grid_df.iloc[-LOOKBACK:]
valid_cols = window.columns[window.isna().mean() < 0.10]
window_clean = window[valid_cols].dropna()
print(f’\nUsable tenors in last {LOOKBACK}d window: {list(valid_cols.values)}’)
print(f’Usable observations: {len(window_clean)}’)

# run pca

n_pcs = min(N_PCS_MAX, len(valid_cols))
eigenvalues, loadings, mu = run_pca(window_clean.values, n_pcs)
var_explained = eigenvalues / eigenvalues.sum()
cum_var = np.cumsum(var_explained)

# — Plot 1: Eigenvalue distribution —

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

ax = axes[0]
ax.bar(range(1, n_pcs + 1), var_explained[:n_pcs] * 100, color=’#2C5F8A’, alpha=0.8, label=‘Individual’)
ax.plot(range(1, n_pcs + 1), cum_var[:n_pcs] * 100, ‘o-’, color=’#D4553A’, linewidth=2, label=‘Cumulative’)
ax.set_xlabel(‘PC’)
ax.set_ylabel(‘Variance Explained (%)’)
ax.set_title(‘CDBCRP 10d Grid - PCA Eigenvalue Distribution’)
ax.legend()
ax.set_xticks(range(1, n_pcs + 1))
ax.axhline(y=95, color=‘gray’, linestyle=’–’, alpha=0.5)
ax.axhline(y=99, color=‘gray’, linestyle=’–’, alpha=0.3)
for i in range(min(5, n_pcs)):
ax.text(i + 1, var_explained[i] * 100 + 1.5, f’{var_explained[i]*100:.1f}%’, ha=‘center’, fontsize=8)

# — Plot 2: Loadings for first 3 PCs —

ax = axes[1]
colors = [’#2C5F8A’, ‘#D4553A’, ‘#4A9B6E’]
tenor_labels = valid_cols.values
for i in range(min(3, n_pcs)):
ax.plot(tenor_labels, loadings[:, i], ‘o-’, color=colors[i], linewidth=1.5, markersize=4, label=f’PC{i+1} ({var_explained[i]*100:.1f}%)’)
ax.axhline(y=0, color=‘gray’, linestyle=’-’, alpha=0.3)
ax.set_xlabel(‘Tenor (days)’)
ax.set_ylabel(‘Loading’)
ax.set_title(‘PCA Loadings - First 3 Components’)
ax.legend()

plt.tight_layout()
plt.savefig(‘pca_eigenvalues_loadings.png’, dpi=150, bbox_inches=‘tight’)
plt.show()
print(’\nEigenvalue summary:’)
for i in range(min(6, n_pcs)):
print(f’  PC{i+1}: {var_explained[i]*100:.2f}%  (cumulative: {cum_var[i]*100:.2f}%)’)

# — Plot 3: Impulse Response Heatmap —

# use retained PCs (95% threshold)

n_retain = np.searchsorted(cum_var, 0.95) + 1
n_retain = max(n_retain, 2)
print(f’\nRetaining {n_retain} PCs for impulse response ({cum_var[n_retain-1]*100:.1f}% variance)’)

irm = impulse_response_matrix(loadings[:, :n_retain], shock_bps=SHOCK_BPS)

fig, ax = plt.subplots(figsize=(12, 10))

# symmetric colormap centered at 0

vmax = np.abs(irm).max()
norm = mcolors.TwoSlopeNorm(vmin=-vmax, vcenter=0, vmax=vmax)
im = ax.imshow(irm, cmap=‘RdBu_r’, norm=norm, aspect=‘auto’,
origin=‘lower’)

ax.set_xticks(range(len(tenor_labels)))
ax.set_xticklabels(tenor_labels.astype(int), rotation=45, fontsize=7)
ax.set_yticks(range(len(tenor_labels)))
ax.set_yticklabels(tenor_labels.astype(int), fontsize=7)
ax.set_xlabel(‘Response Tenor (days)’)
ax.set_ylabel(‘Shock Tenor (days)’)
ax.set_title(f’Impulse Response: {SHOCK_BPS}bps Shock Propagation via Min-Norm PCA ({n_retain} PCs)’)

cbar = plt.colorbar(im, ax=ax, shrink=0.8)
cbar.set_label(‘Response (bps)’)

# annotate cells with values

for i in range(len(tenor_labels)):
for j in range(len(tenor_labels)):
val = irm[i, j]
if abs(val) > 0.5:
color = ‘white’ if abs(val) > vmax * 0.6 else ‘black’
ax.text(j, i, f’{val:.1f}’, ha=‘center’, va=‘center’, fontsize=5, color=color)

plt.tight_layout()
plt.savefig(‘impulse_response_heatmap.png’, dpi=150, bbox_inches=‘tight’)
plt.show()

# — Summary stats —

print(f’\nImpulse response summary ({SHOCK_BPS}bps shock):’)
print(f’  Diagonal (self-response) range: {irm.diagonal().min():.1f} to {irm.diagonal().max():.1f} bps’)
print(f’  Off-diagonal abs mean: {np.abs(irm[~np.eye(len(tenor_labels), dtype=bool)]).mean():.2f} bps’)
print(f’  Off-diagonal abs max: {np.abs(irm[~np.eye(len(tenor_labels), dtype=bool)]).max():.1f} bps’)
print(f’  Max propagation ratio: {np.abs(irm).max() / SHOCK_BPS:.2f}x’)

# show which shock tenors propagate most

avg_abs_response = np.abs(irm).mean(axis=1)
print(f’\nAverage absolute response by shock tenor:’)
for i, t in enumerate(tenor_labels):
print(f’  {int(t):>4d}d shock -> avg {avg_abs_response[i]:.2f} bps response’)