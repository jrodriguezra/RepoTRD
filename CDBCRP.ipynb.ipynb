# %% Cell 1 - Imports & Config

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.colors as mcolors
from matplotlib.ticker import FuncFormatter

FILE_PATH = ‘Data_historica.xlsx’
TENORS_GRID = np.arange(10, 370, 10)  # 10, 20, …, 360
LOOKBACK = 200
SHOCK_BPS = 10
N_PCS_MAX = 10

# %% Cell 2 - Functions

def monotone_convex_interpolate(tenors, yields, target_tenors):
# hagan-west 2006 monotone convex on yields
# tenors and yields must be sorted ascending, tenors > 0
t = np.array(tenors, dtype=float)
y = np.array(yields, dtype=float)
n = len(t)
if n < 2:
return np.full(len(target_tenors), np.nan)

```
# forward rates at knot points via f(t_i) = d(t_i * y_i)/dt_i
# discrete forward: f_i = (t_i*y_i - t_{i-1}*y_{i-1}) / (t_i - t_{i-1})
ty = t * y
f = np.zeros(n)
f[0] = y[0]  # instantaneous forward at first knot = yield
for i in range(1, n):
    f[i] = (ty[i] - ty[i - 1]) / (t[i] - t[i - 1])

# forward rates at knot midpoints (the discrete forwards are the sector forwards)
# estimate instantaneous forwards at knots using hagan-west
f_inst = np.zeros(n)
f_inst[0] = f[0]
f_inst[-1] = f[-1]
for i in range(1, n - 1):
    dt_l = t[i] - t[i - 1]
    dt_r = t[i + 1] - t[i]
    f_inst[i] = (dt_r * f[i] + dt_l * f[i + 1]) / (dt_l + dt_r)

# monotonicity correction
for i in range(n):
    if i == 0:
        f_inst[i] = max(f_inst[i], 0)
        f_inst[i] = min(f_inst[i], 2 * f[0]) if n > 1 else f_inst[i]
    elif i == n - 1:
        f_inst[i] = max(f_inst[i], 0)
        f_inst[i] = min(f_inst[i], 2 * f[-1])
    else:
        f_inst[i] = max(f_inst[i], 0)
        f_inst[i] = min(f_inst[i], 2 * min(f[i], f[i + 1]))
        f_inst[i] = max(f_inst[i], 2 * max(f[i], f[i + 1]) - 2 * max(f[i], f[i + 1]))

# interpolation: for each target tenor, find the sector and integrate
result = np.zeros(len(target_tenors))
for k, tt in enumerate(target_tenors):
    if tt <= t[0]:
        # flat extrapolation at short end
        result[k] = y[0]
    elif tt >= t[-1]:
        # flat extrapolation at long end
        result[k] = y[-1]
    else:
        # find sector
        idx = np.searchsorted(t, tt, side='right') - 1
        idx = min(idx, n - 2)
        t0, t1 = t[idx], t[idx + 1]
        y0, y1 = y[idx], y[idx + 1]
        f0, f1 = f_inst[idx], f_inst[idx + 1]
        dt = t1 - t0
        x = (tt - t0) / dt  # x in [0, 1]

        # sector forward rate
        g = (t1 * y1 - t0 * y0) / dt

        # monotone convex forward: quadratic hermite
        # f(x) = (1-x)*f0 + x*f1 + x*(1-x)*((1-x)*(f0 - g) + x*(f1 - g)) ... nope
        # simpler: linear on forward with monotonicity
        # hagan-west: f(x) = g + (f0 - g)*(1-x) + (f1 - g)*x ... no
        # use the integrated yield directly
        # integral of forward from 0 to tt = tt * y(tt)
        # in sector [t0, t1]: integral from t0 to tt of f(s) ds
        # f(s) interpolated linearly in sector: f(s) = f0 + (f1-f0)*(s-t0)/(t1-t0)
        # but with monotone convex correction

        # pragmatic: use quadratic interpolation on the discount function
        # tt*y(tt) = t0*y0 + integral_{t0}^{tt} f(s) ds
        # with linear forward in sector: integral = (tt-t0) * [g + 0.5*(f0-g)*(1-x) + 0.5*(f1-g)*x]
        # ... let me use the proper hagan-west formula

        # hagan-west section 3: the interpolant on the zero rate function
        # define g_i = f_i (sector discrete forward), f_i^0 = f_inst at left, f_i^1 = f_inst at right
        # the interpolated forward is:
        # f(x) = g + (f0_inst - g)*(1 - 4x + 3x^2) + (f1_inst - g)*(-2x + 3x^2)
        # but only if monotonicity holds; otherwise constrain

        a = f0 - g
        b = f1 - g

        # quadratic hermite forward
        fwd_x = g + a * (1 - 4*x + 3*x**2) + b * (-2*x + 3*x**2)

        # integrate: int_0^x f(s) ds where s is normalized
        # int f(s) ds from 0 to x = g*x + a*(x - 2x^2 + x^3) + b*(-x^2 + x^3)
        integral_norm = g * x + a * (x - 2*x**2 + x**3) + b * (-x**2 + x**3)

        # tt * y(tt) = t0*y0 + dt * integral_norm
        tty = t0 * y0 + dt * integral_norm
        result[k] = tty / tt
return result
