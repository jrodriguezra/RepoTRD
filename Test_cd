# IMPORTANTE: Renombrar 'SBP_rate' a 'Yield' si necesario y asegurar que existe 'Dias'
# Si no tienes 'Dias', debes calcularla antes de este punto.
df_historico = df_historico.rename(columns={'SBP_rate': 'Yield'})
