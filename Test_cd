# 2. Definir parámetros fijos
nodos_deseados = [1, 7, 14, 21, 30, 60, 90, 180, 360] # Tus nodos estándar
lista_de_resultados = []

print("Iniciando cálculo masivo...")

# 3. El corazón del proceso: GROUPBY
# Esto agrupa los datos por fecha. 'fecha_idx' es la fecha del grupo, 
# 'grupo_df' es el pequeño DataFrame que solo contiene datos de ESA fecha.
for fecha_idx, grupo_df in df_historico.groupby('Fecha'):
    
    # Aplicamos nuestra función a este día específico
    try:
        df_fwd_dia = calcular_curva_forward(df_dia=grupo_df, 
                                            nodos_fijos=nodos_deseados, 
                                            dias_shift=1)
        
        # Le agregamos la fecha para saber a qué día pertenece este cálculo
        df_fwd_dia['Fecha_Dato'] = fecha_idx
        
        # Guardamos el resultado en la lista
        lista_de_resultados.append(df_fwd_dia)
        
    except Exception as e:
        print(f"Error procesando la fecha {fecha_idx.date()}: {e}")
        continue

# 4. Consolidar todo en un solo gran DataFrame
df_final_historico = pd.concat(lista_de_resultados, ignore_index=True)

# Reordenar columnas para que se vea bien
df_final_historico = df_final_historico[['Fecha_Dato', 'Nodo', 'Yield_Base', 'Forward_Calculado']]

