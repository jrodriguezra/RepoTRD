import pandas as pd
import numpy as np

# --- Definición de la Función ---
def calcular_curva_forward(df_dia, nodos_fijos, dias_shift=1):
    """
    Toma un DataFrame de UN SOLO DÍA (con columnas 'Dias' y 'Yield'),
    interpola la curva base y la curva desplazada, y calcula los forwards.
    """
    # 1. Asegurar orden y extraer vectores
    df_dia = df_dia.sort_values('Dias')
    dias_conocidos = df_dia['Dias'].values
    # Asumo que la columna de tasa se llama 'Yield'. Si es 'SBP_rate', cámbialo aquí.
    yields_conocidos = df_dia['Yield'].values 

    # 2. Interpolación Curva Base (t1, r1)
    # Si algún nodo es menor al mínimo día disponible, repetirá el primer valor (extrapolación plana)
    r1_interp = np.interp(nodos_fijos, dias_conocidos, yields_conocidos)
    t1 = np.array(nodos_fijos)
    r1 = r1_interp / 100 # Dividir por 100 para la fórmula

    # 3. Interpolación Curva Desplazada (t2, r2)
    # Creamos los nodos futuros (ej. nodo 7 pasa a ser día 8)
    t2 = t1 + dias_shift 
    r2_interp = np.interp(t2, dias_conocidos, yields_conocidos)
    r2 = r2_interp / 100

    # 4. Cálculo Vectorizado del Forward (Sin bucle for)
    # Aplicamos la fórmula corregida (usando t1 al final) a todos los elementos a la vez
    # Usamos np.where para evitar división por cero si el primer nodo es 0
    with np.errstate(divide='ignore', invalid='ignore'):
        fwd_calc = (((1 + r2)**(t2 / 360)) / ((1 + r1)**(dias_shift / 360)))**(360 / t1) - 1
        # Corregir si el primer nodo es 0 (el forward 0d0d no tiene sentido así, suele ser la tasa overnight)
        fwd_calc = np.where(t1 == 0, r1, fwd_calc) 

    # 5. Crear DataFrame de resultados
    df_resultado = pd.DataFrame({
        'Nodo': t1,
        'Yield_Base': r1_interp,
        'Forward_Calculado': fwd_calc * 100
    })








import pandas as pd

# --- CARGA Y PREPARACIÓN DE DATOS ---
# Cambia las rutas por los nombres o rutas exactas de tus archivos
df_cdbcrp = pd.read_excel('ruta_a_tu_historico_cdbcrp.xlsx')
df_tibo = pd.read_excel('ruta_a_tu_historico_tibo.xlsx', sheet_name='Diarias')

# Aseguramos que la columna 'Fecha' sea reconocida como formato de fecha
df_cdbcrp['Fecha'] = pd.to_datetime(df_cdbcrp['Fecha'])
df_tibo['Fecha'] = pd.to_datetime(df_tibo['Fecha'])

# Preparar TIBO: Le agregamos el Día 1 y un ISIN referencial para que cuadre
df_tibo['Dias'] = 1
df_tibo['ISIN'] = 'TIBO'

# Juntar ambos históricos (Pandas alinea Fecha, Yield y Dias automáticamente)
insumos_historicos = pd.concat([df_tibo, df_cdbcrp], ignore_index=True)


# --- PROCESAMIENTO MASIVO ---
nodos_deseados = [1, 7, 14, 21, 30, 60, 90, 180, 360] 
lista_de_resultados = []

print("Iniciando cálculo masivo...")

for fecha_idx, grupo_df in insumos_historicos.groupby('Fecha'):
    try:
        # Usamos tu función matemática intacta
        df_fwd_dia = calcular_curva_forward(df_dia=grupo_df, 
                                            nodos_fijos=nodos_deseados, 
                                            dias_shift=1)
        
        # Agregamos la fecha al resultado de ese día
        df_fwd_dia['Fecha'] = fecha_idx
        lista_de_resultados.append(df_fwd_dia)
        
    except Exception as e:
        print(f"Error procesando la fecha {fecha_idx.date()}: {e}")
        continue

# --- RESULTADO FINAL ---
# Consolidar todo en un solo DataFrame
df_final_historico = pd.concat(lista_de_resultados, ignore_index=True)

# Ordenar columnas para mayor claridad
df_final_historico = df_final_historico[['Fecha', 'Nodo', 'Yield_Base', 'Forward_Calculado']]

print("Cálculo finalizado exitosamente.")
print(df_final_historico.head(15))
