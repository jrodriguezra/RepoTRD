# Colour only the nearest SD band row per tenor
for j, val in enumerate(mispricing):
    if val > 0:
        # Actual is above FV → upper band is nearest → colour row 4 (Dist to Upper)
        color = "#d4f0d4"
        table[4, j].set_facecolor(color)
    else:
        # Actual is below FV → lower band is nearest → colour row 5 (Dist to Lower)
        color = "#f0d4d4"
        table[5, j].set_facecolor(color)
