# identify outlier dates per tenor
# outlier defined as abs(diff) > mean + 3*std for each tenor

cols = [f'{tau}Y' for tau in CMT_TENORS]
outlier_rows = []

for col in cols:
    col_data = df_diff[['Fecha', col]].dropna()
    mean_v = col_data[col].mean()
    std_v  = col_data[col].std()
    cutoff = 3 * std_v
    mask   = col_data[col].abs() > cutoff
    flagged = col_data[mask].copy()
    flagged['Tenor'] = col
    flagged['Diff_bps'] = flagged[col]
    outlier_rows.append(flagged[['Fecha', 'Tenor', 'Diff_bps']])

df_outliers = pd.concat(outlier_rows).sort_values('Diff_bps', ascending=False)
df_outliers['Year'] = pd.to_datetime(df_outliers['Fecha']).dt.year

print('Outlier count by year:')
print(df_outliers.groupby('Year').size().sort_values(ascending=False).to_string())

print('\nOutlier count by year and tenor:')
print(df_outliers.groupby(['Year', 'Tenor']).size().unstack(fill_value=0).to_string())

print('\nLargest outliers (top 20):')
print(df_outliers.head(20)[['Fecha', 'Tenor', 'Diff_bps']].to_string())
