def build_cmt(df_clean, tenors=CMT_TENORS, min_bonds=MIN_BONDS):
records = []
skipped = 0
for date, grp in df_clean.groupby(‘Fecha’):
grp = (
grp.dropna(subset=[‘Maturity’, ‘FV.Rate’])
.sort_values(‘Maturity’)
.drop_duplicates(‘Maturity’)
)
if len(grp) < min_bonds:
skipped += 1
continue
t     = grp[‘Maturity’].values
y     = grp[‘FV.Rate’].values
t_min = t.min()
t_max = t.max()
try:
curve = MonotoneConvexCurve(t, y)
row   = {‘Fecha’: date}
for tau in tenors:
col      = f’{tau}Y’
row[col] = (
round(curve.yield_at(tau), 4)
if t_min <= tau <= t_max
else np.nan
)
records.append(row)
except Exception:
skipped += 1
df_cmt = (
pd.DataFrame(records)
.set_index(‘Fecha’)
.sort_index()
)
df_cmt.index.name = ‘Fecha’
print(f’CMT built: {len(df_cmt):,} dates | skipped: {skipped:,}’)
return df_cmt

def compare_curves(df_cmt, df_interpol, tenors=CMT_TENORS):
cols = [f’{tau}Y’ for tau in tenors]
if ‘Fecha’ in df_interpol.columns:
df_li = df_interpol.set_index(‘Fecha’)[cols].copy()
else:
df_li = df_interpol[cols].copy()
df_mc  = df_cmt[cols].copy()
shared = df_mc.index.intersection(df_li.index)
df_mc  = df_mc.loc[shared]
df_li  = df_li.loc[shared]
df_diff = (df_mc - df_li) * 100
stats         = df_diff.describe().T[[‘mean’, ‘std’, ‘min’, ‘25%’, ‘50%’, ‘75%’, ‘max’]]
stats.columns = [‘Mean’, ‘Std’, ‘Min’, ‘P25’, ‘Median’, ‘P75’, ‘Max’]
stats         = stats.round(3)
print(’\nDifference MC minus Linear Interpolation (bps)’)
print(stats.to_string())
fig, ax   = plt.subplots(figsize=(13, 5))
data_plot = [df_diff[c].dropna().values for c in cols]
bp = ax.boxplot(
data_plot,
tick_labels=cols,
patch_artist=True,
medianprops=dict(color=‘black’, linewidth=1.8),
flierprops=dict(marker=‘o’, markersize=2, alpha=0.3, color=‘grey’),
whiskerprops=dict(linewidth=1.2),
capprops=dict(linewidth=1.2)
)
colors = plt.cm.RdYlBu(np.linspace(0.1, 0.9, len(cols)))
for patch, color in zip(bp[‘boxes’], colors):
patch.set_facecolor(color)
patch.set_alpha(0.75)
ax.axhline(0, color=‘black’, linewidth=1.0, linestyle=’–’, alpha=0.7)
ax.set_title(‘Monotone Convex vs Linear Interpolation — Difference by CMT Node (bps)’, fontsize=12, fontweight=‘bold’)
ax.set_xlabel(‘CMT Tenor’, fontsize=10)
ax.set_ylabel(‘MC minus Linear (bps)’, fontsize=10)
ax.grid(axis=‘y’, linestyle=’:’, alpha=0.5)
plt.tight_layout()
plt.savefig(’/mnt/user-data/outputs/cmt_comparison.png’, dpi=150)
plt.show()
print(‘Boxplot saved.’)
return df_diff, stats

