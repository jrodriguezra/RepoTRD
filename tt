```
with open(input_txt, "r") as f:
    for line in f:
        raw = line.strip()
        if not raw:
            continue
        try:
            date_obj = datetime.strptime(raw, "%m/%d/%Y")
            converted_dates.append(date_obj.strftime("%d/%m/%Y"))
        except ValueError:
            print(f"Skipping invalid date: '{raw}'")
            converted_dates.append(None)

# Saves the Excel file in the same folder as the TXT file
output_xlsx = input_txt.replace(".txt", "_converted.xlsx")

df = pd.DataFrame(converted_dates, columns=["Date (dd/MM/yyyy)"])
df.to_excel(output_xlsx, index=False)
print(f"Done! File saved to: {output_xlsx}")
