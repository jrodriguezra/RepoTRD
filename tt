# %% Cell 4 – Regime Chart (UPDATED: y-axis = spread level)

def plot_regime_chart(regimes_df, spread_name, weeks, lookback):
“””
Bar chart where bar height = spread level in bps,
bar color = regime, with spread level line overlaid.
“””
n_days = weeks * 5
